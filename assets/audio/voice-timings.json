 "segments": [
  {
   "start": 0,
   "end": 2.2,
   "text": "March 2025."
  },
  {
   "start": 2.2,
   "end": 5,
   "text": "Athena lands at the lunar South Pole."
  },
  {
   "start": 5,
   "end": 7.5,
   "text": "Thirteen hours later, it's dead."
  },
  {
   "start": 7.5,
   "end": 9.84,
   "text": "Here, the sun never rises."
  },
  {
   "start": 9.84,
   "end": 11.64,
   "text": "It circles the horizon."
  },
  {
   "start": 11.64,
   "end": 14.28,
   "text": "One ridge, and your lander goes dark."
  },
  {
   "start": 14.28,
   "end": 16.24,
   "text": "So, we crash it first."
  },
  {
   "start": 16.24,
   "end": 19.62,
   "text": "Thousands of times, on NASA's real terrain."
  },
  {
   "start": 19.62,
   "end": 23.46,
   "text": "Last Light tells you where and when your lander survives."
  },
  {
   "start": 23.46,
   "end": 26.36,
   "text": "Open source for every mission to the pole."
  }
 ],
